#TUPLE:-
tup = (1, 2, 3, 4, 5)
print(type(tup))
print(tup)


#acessing the elements of tuple
print(tup[2])  #it will print the 3rd element of tuple


#assingment is not allowed in tuple
tup[2] = 10  #it will give error because tuple is immutable


#lets print empty tuple
tup = ()
print(tup)



#we can also create tuple with single element
tup = (1,) #we have to put comma after the element otherwise it will be considered as integer and the output will be integer not tuple
print(tup)

tup1 = ("hello",) #we have to put comma after the element otherwise it will be considered as string and the output will be string not tuple
print(tup1)








##slicing in tuple
tup3 = (1, 2, 75, 55, 3, 464)
print(tup3[2:4]) #it will print the elements from index 2 to 3 (4 is not included)










##TUPLE METHODS
#1. tuple.index(element) - returns the index of the first occurrence of the element
#2. tuple.count(element) - returns the number of occurrences of the element in the tuple

#1. 
tup4 = (1, 2, 3, 4, 5, 6, 7, 8, 7, 3, 9, 7, 10)
print(tup4.index(7)) #it will print the index of the first occurrence of 7 in the tuple

#2.tuple.count(element)
print(tup4.count(7)) #it will print the number of occurrences of 7 in the tuple


















