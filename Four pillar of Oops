#super() method or function:-
#super() method is used to access the parent class methods and properties in the child class.

class Hello:
   def __init__(self, name):
      self.name = name
        
      @staticmethod
      def greet():
         print("hyy")

class Welcome(Hello):
   def __init__(self,age, name):
      self.age = age
      super(). __init__(name)   #it has accesed the parent class (hello) method and property using super() function.
   
   

k = Welcome(30, "roy")

print(k.name)





