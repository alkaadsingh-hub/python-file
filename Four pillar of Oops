#3.Inheritance:-
#when one class(child/ derived) derivesthe property and method of another class(parent/ base).
# there are 3 types of inheritance :-
#1. single inheritance
#2. multi-level 
#3. multiple inheritance 

#syntax toinherit the property of another class :-
# class Class_name(another class name):   #to show inheritance we use paranthesis
class Car:
    @staticmethod   #we are using staticmethod because rn we are not using car as an object
    def start():
        print("car started")

    @staticmethod
    def stop():
        print("car stopped")


#now we are creating another class to inherit the property of another class (the above class )

class BMW(Car):
 def __init__(self, name):
     self.name = name


#creating an object 
car1 = BMW("abcdef")

print(car1.name)      #thiswill print the name ofthe car

print(car1.start())   #this will print the"car started" as it has taken heritance from another class



