#RANGE FUNCTION:-
#range function is used to generate a sequence of numbers. it starts with 0 by default and increments by 1 (by default) and stops before a specified number.


print(range(4))  # Output: range(0, 4)


#lets print the sequence of number 
num = range(10)

print(num[0])
print(num[1])
print(num[2])
print(num[3])
print(num[4])



#lets print the sequnce of number using "for loop"

num1 = range(7)    #range does not include last number so here, 7 is not included 

for values in num1:
    print(values)

        ## OR

for el in range(7):
    print(el)






## There are three ways to write a range function

# range(start,stop,step)


#1. START:-
#not mandatory to provide ...as the starting value will be set as 0 by default

#3. STOP:-
#this is must ...we need toprvide the stop value.

#3.STEP:-
#step size is used to increment the value .....it take it as 1 by default 




#lets print even number 
for value1 in range(2, 100, 2):  #range(start,stop,step)
    print(value1)




