#write a function to calculate the sum of first n natural numbers using recursion:-

def sum(n):
    if(n == 0):     ##base case - it will stop the recursion when n is 0
        return 0
    return sum(n-1) + n   ##it will call itself with a different argument and add the value of n to the result of the recursive call

print(sum(20)) ##function called






